rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          get(/databases/{database}/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email != null && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com'])
        );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow user creation without admin escalation, or admin can update anything
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'customer' || 
        (request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com'])
      );
      allow update: if (isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == resource.data.role ||
        (request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com'])
      )) || isAdmin();
      allow delete: if isAdmin();

      // Cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId);
      }

      // Wishlist subcollection
      match /wishlist/{wishlistItemId} {
        allow read, write: if isOwner(userId);
      }

      // Addresses subcollection
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
      }
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAuthenticated() && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com']);
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAuthenticated() && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com']);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin() || (isAuthenticated() && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com']);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com']) || (
        isAuthenticated() && resource.data.userId == request.auth.uid && 
        // User can only cancel pending order
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'updatedAt', 'cancelReason']) &&
        request.resource.data.orderStatus == 'cancelled' &&
        resource.data.orderStatus == 'pending'
      );
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAuthenticated() && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com']);
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.email in ['admin@sanubuilds.com', 'anritvox@gmail.com']);
    }
  }
}
